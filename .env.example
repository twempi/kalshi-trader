# Copy to .env (which is git-ignored) and fill in. Placeholder values only.
#
# Kalshi API credentials are OPTIONAL. All market data and live tennis scores used by this
# project are public over REST. Credentials are only needed for the real-time WebSocket feed
# (Kalshi requires an authenticated handshake even for public channels).
# Use a key with only the "read" scope. This application never sends orders.
# KT_KALSHI__API_KEY_ID=00000000-0000-0000-0000-000000000000
# KT_KALSHI__PRIVATE_KEY_PATH=secrets/kalshi-read-only.key

# Optional overrides (see config/settings.toml for all settings)
# KT_KALSHI__ENVIRONMENT=prod
# KT_LOG_LEVEL=INFO
# KT_DB_PATH=data/kalshi_trader.db
# KT_PAPER__STARTING_BALANCE=1000
# KT_DASHBOARD__PORT=8787
# KT_CONFIG_PATH=config/settings.toml
